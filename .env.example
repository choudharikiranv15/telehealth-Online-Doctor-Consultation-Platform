# TeleHealth Platform - Environment Variables Example
# NOTE: InfinityFree does NOT support .env files!
# For InfinityFree, edit config.php directly (see INFINITYFREE_SETUP.md)

# This file is for cloud platforms like Railway, Render, Heroku only

# Database Configuration
DB_HOST=localhost
DB_NAME=telehealth
DB_USER=root
DB_PASS=

# Application Configuration
SITE_URL=http://localhost/telehealth
APP_ENV=development

# For production deployment on cloud platforms:
# APP_ENV=production
# SITE_URL=https://yourdomain.com

# Email Configuration (for password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=iHealth MediCare

# Security Settings
SESSION_TIMEOUT=3600
MAX_FILE_SIZE=5242880

# Deployment Examples:

# For InfinityFree:
# DB_HOST=sql123.infinityfree.com
# DB_NAME=if0_12345678_telehealth
# DB_USER=if0_12345678
# DB_PASS=your_password
# SITE_URL=https://yoursubdomain.rf.gd

# For Railway:
# DB_HOST=containers-us-west-123.railway.app
# DB_NAME=railway
# DB_USER=root
# DB_PASS=generated_password
# SITE_URL=https://yourapp.railway.app

# For 000webhost:
# DB_HOST=localhost
# DB_NAME=id12345_telehealth
# DB_USER=id12345_user
# DB_PASS=your_password
# SITE_URL=https://yoursubdomain.000webhostapp.com
